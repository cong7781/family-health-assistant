<?xml version="1.0" encoding="UTF-8" ?>
        <!DOCTYPE mapper
                PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
                "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.familyhealth.mapper.LoginMapper">
<select id="login" resultType="com.example.familyhealth.model.Member">
    SELECT id, account,name,gender,phone
    FROM member
    WHERE account = #{account} AND password = #{password}
</select>


</mapper>